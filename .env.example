# ------------------------------------------------------------------
# SkillSwap environment variables (copy to .env and fill in real values)
# Never commit a real .env file.
# ------------------------------------------------------------------

# --- Server -------------------------------------------------------
NODE_ENV=development
PORT=4710

# PostgreSQL connection string
DATABASE_URL=postgresql://skillswap:skillswap@localhost:5432/skillswap
# Separate database used by the automated test suite (it is reset on every run)
TEST_DATABASE_URL=postgresql://skillswap:skillswap@localhost:5432/skillswap_test

# Secret used to sign authentication tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Token/session lifetime, e.g. 7d, 12h
JWT_EXPIRES_IN=7d
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Allowed browser origin(s) for the API (comma separated)
CLIENT_ORIGIN=http://localhost:5174

# Public URL of the client, used to build password reset links
CLIENT_URL=http://localhost:5174

# --- File storage -------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2

# --- Email (optional) ---------------------------------------------
# When left empty, password reset emails are written to the server log
# and (in development only) returned by the API so the flow can be tested.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SkillSwap <no-reply@skillswap.local>

# --- Client (Vite reads variables prefixed with VITE_) ------------
# Leave empty to use the dev-server proxy (/api). Set to the deployed API URL in production.
VITE_API_URL=
